NODE_ENV=development
HOST=127.0.0.1
PORT=8080
# Local mode cannot bind a public interface or run in production.
NAVI_AUTH_MODE=local
# Separate SERVER credential: enable Places API (New) and Routes API.
# Never put this server key in the Flutter env.json asset.
GOOGLE_MAPS_SERVER_KEY=
# Required when NAVI_AUTH_MODE=firebase (all deployed environments).
FIREBASE_PROJECT_ID=
# Per process limits; additionally configure Google API quotas and instance caps.
NAVI_REQUESTS_PER_MINUTE=20
